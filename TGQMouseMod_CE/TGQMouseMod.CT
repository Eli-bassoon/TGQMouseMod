    <CheatEntry>
      <ID>127</ID>
      <Description>"Count Resources"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[Enable]
insertions = 0;
resInsertions = 0;

-- Hashmap
function incInsertions1()
    insertions = insertions + 1;
    local hash = readInteger(ESP + 0x4);
    print("hashes " .. insertions .. " loading 0x" .. string.format("%x", hash));
end

function incInsertions2()
    insertions = insertions + 1;
    local nameAddr = readInteger(ESP + 0x4);
    local name = readString(nameAddr, 32);
    print("hashes " .. insertions .. " loading " .. name);
end

function decInsertions()
    insertions = insertions - 1;
    local hash = readInteger(ESP + 0xC);
    print("hashes " .. insertions .. " deleting 0x" .. string.format("%x", hash));
end

function clearInsertions()
    insertions = 0;
    print("hashes " .. insertions .. " clear");
end

function isoom()
    print("OOM ===========================================");
    return true;
end


-- Pool
function incResInsertions()
    if (EDI == readInteger(0x004e4540)) then
        resInsertions = resInsertions + 1;
        print("res " .. resInsertions .. " loading");
    end
end

-- Breakpoints
debug_setBreakpoint(0x0043147b, isoom);
debug_setBreakpoint(0x00431529, isoom);
debug_setBreakpoint(0x00431450, incInsertions1);
debug_setBreakpoint(0x004314a0, incInsertions2);
debug_setBreakpoint(0x00431570, decInsertions);
debug_setBreakpoint(0x00431600, clearInsertions);

debug_setBreakpoint(0x00425baa, incResInsertions);

[Disable]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>128</ID>
      <Description>"Event Hash Map"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[Enable]

eventHashmap = nil;
function getEventHashmap()
    if (eventHashmap == nil) then
        -- Grab the hashmap
        eventHashmap = ESI;
        print("Hashmap is at 0x" .. string.format("%x", eventHashmap));

        local backingArray = readInteger(ESI);
        print("Backing array is at 0x" .. string.format("%x", backingArray));

        -- Set a data breakpoint if we overwrite this
        debug_setBreakpoint(ESI, 4, 2);
    end
end

debug_setBreakpoint(0x00431142, getEventHashmap);

[Disable]
eventHashmap = nil;
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>129</ID>
      <Description>"See kcFree"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[Enable]

function seeMalloc()
    print("Allocating 0x" .. string.format("%x", EAX));
end

function seeFree()
    print("Freeing 0x" .. string.format("%x", ECX));
end

function seeDynFree()
    print("Dyn Freeing 0x" .. string.format("%x", EAX));
end

debug_setBreakpoint(0x00401b54, seeFree);
debug_setBreakpoint(0x004019fa, seeMalloc);
debug_setBreakpoint(0x004215b4, seeDynFree);

[Disable]
</AssemblerScript>
    </CheatEntry>
